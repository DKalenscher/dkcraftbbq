# Copy this to .env and fill in your values
# IMPORTANT: Change all values before deploying

# Strong random secret key for JWT signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY

# Admin credentials (set on first run; changeable via UI after that)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# Server settings
HOST=0.0.0.0
PORT=8000

# How long admin login sessions last (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated, use * for local-only or set to your Pi's IP)
ALLOWED_ORIGINS=http://localhost:8000,http://192.168.1.100:8000
